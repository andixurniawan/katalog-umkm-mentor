# Salin file ini menjadi .env.local lalu isi nilainya.
# Isi juga variabel yang sama di Vercel: Project > Settings > Environment Variables.
#
# PENTING: semua variabel di bawah hanya dipakai di SERVER.
# JANGAN beri awalan NEXT_PUBLIC_ supaya tidak terkirim ke browser.
#
# Lokasi di dashboard Supabase: Project Settings > API (atau API Keys).
# Jika proyekmu masih memakai key lama, pakai "anon" untuk PUBLISHABLE
# dan "service_role" untuk SECRET.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI untuk US-14 (pembuatan deskripsi otomatis). Pilih salah satu penyedia:
#
# 1) Gateway kompatibel OpenAI (contoh 9router). Jika diisi, ini yang dipakai.
#    LLM_BASE_URL berakhir di /v1, LLM_MODEL bawaannya "gemini".
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemini
#
# 2) Gemini API langsung (dipakai jika LLM_* di atas kosong).
GEMINI_API_KEY=

# Alamat situs untuk link Open Graph, sitemap, dan robots (US-26, US-27), contoh: https://tokomu.vercel.app
# Opsional di Vercel (terisi otomatis dari domain produksi); isi jika memakai domain sendiri.
SITE_URL=
